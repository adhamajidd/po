<?xml version="1.0" encoding="utf-8"?>
<templates id="template" xml:space="preserve">
    
    <t t-name="custom_pos_receipt_for_pos.OrderReceipt" t-inherit="point_of_sale.OrderReceipt" t-inherit-mode="extension">
        <!-- Menghilangkan bagian pajak dari receipt -->
        <xpath expr="//div[@class='pos-receipt-taxes']" position="replace">
        </xpath>
        
        <!-- Alternatif: Menghilangkan hanya tag <p> yang berisi "Powered by Odoo" -->
        <xpath expr="//p[text()='Powered by Odoo']" position="replace">
        </xpath>
        
        <!-- Menghilangkan footer yang mungkin ada dari modul lain -->
        <xpath expr="//div[@class='pos-receipt-center-align']" position="replace">
        </xpath>
        
        <!-- Mengubah footer dengan format yang diinginkan -->
        <xpath expr="//div[@class='pos-receipt-order-data']" position="replace">
            <div class="pos-receipt-order-data">
                <div style="margin: 1px -10px;">.......................................</div>
                <div style="text-align: center; font-weight: bold; margin: 5px 0; font-family: Arial, sans-serif; font-size: 8pt;">
                    *** TERIMA KASIH ATAS KUNJUNGAN ANDA ***
                </div>
                <div style="text-align: center; margin: 2px 0; font-family: Arial, sans-serif; font-size: 8pt;">
                    Barang yang dibeli tidak dapat
                </div>
                <div style="text-align: center; margin: 2px 0; font-family: Arial, sans-serif; font-size: 8pt;">
                    dikembalikan kecuali cacat produk
                </div>
                <div style="margin: 1px -10px;">.......................................</div>
            </div>
        </xpath>
        
        <!-- Menghilangkan tanggal di footer -->
        <xpath expr="//div[@id='order-date']" position="replace">
        </xpath>

        <xpath expr="//div[@class='pos-receipt-order-data'][.//div[@t-esc='props.data.name']]" position="replace">
            <div t-if="false"/>
        </xpath>

        <!-- Ubah ukuran font total -->
        <xpath expr="//div[hasclass('pos-receipt-amount', 'receipt-total')]" position="replace">
            <div class="payment-section" style="font-size: 8pt;">
                <div class="pos-receipt-amount d-flex justify-content-between">
                    <span>Subtotal</span>
                    <span t-esc="props.formatCurrency(props.data.taxTotals.order_sign * props.data.taxTotals.order_total)"/>
                </div>
                <div class="text-center" style="margin: 1px -10px;">---------------------------------</div>
                <div class="pos-receipt-amount receipt-total d-flex justify-content-between">
                    <span>TOTAL</span>
                    <span t-esc="props.formatCurrency(props.data.taxTotals.order_sign * props.data.taxTotals.order_total)"/>
                </div>
                <div class="text-center" style="margin: 1px -10px;">---------------------------------</div>
            </div>
        </xpath>

        <xpath expr="//div[@class='pos-receipt-amount receipt-total']" position="after">
        </xpath>

        <xpath expr="//div[hasclass('paymentlines')]" position="replace">
            <div class="paymentlines d-flex justify-content-between" style="font-size: 8pt;">
                <span>Bayar Tunai</span>
                <span t-esc="props.formatCurrency(line.amount)"/>
            </div>
        </xpath>

        <!-- Tambahkan Kembalian -->
        <xpath expr="//div[@class='pos-receipt-amount receipt-change']" position="replace">
            <div class="pos-receipt-amount receipt-change d-flex justify-content-between" style="font-size: 8pt;">
                <span>Kembalian</span>
                <span t-esc="props.formatCurrency(props.data.order_change)"/>
            </div>
        </xpath>

    </t>


</templates>
