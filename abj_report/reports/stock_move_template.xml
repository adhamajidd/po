<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="template_custom_stock_move">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <div class="page">
                        <h2 class="text-center">Laporan Perpindahan Stok</h2>
                        
                        <div class="row mt-4">
                            <div class="col-12">
                                <strong>Dokumen Referensi:</strong> 
                                <span t-field="o.reference"/>
                            </div>
                        </div>

                        <table class="table table-sm mt-4">
                            <thead>
                                <tr>
                                    <th>Produk</th>
                                    <th class="text-end">Jumlah</th>
                                    <th>Lokasi Asal</th>
                                    <th>Lokasi Tujuan</th>
                                    <th>Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td>
                                        <span t-field="o.product_id.display_name"/>
                                    </td>
                                    <td class="text-end">
                                        <span t-field="o.product_uom_qty"/> <span t-field="o.product_uom.name"/>
                                    </td>
                                    <td>
                                        <span t-field="o.location_id.display_name"/>
                                    </td>
                                    <td>
                                        <span t-field="o.location_dest_id.display_name"/>
                                    </td>
                                    <td>
                                        <span t-field="o.state"/>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                        
                        <div class="mt-4">
                            <strong>Tanggal Selesai:</strong>
                            <p t-field="o.date"/>
                        </div>
                        
                        </div>
                </t>
            </t>
        </t>
    </template>
</odoo>