<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="template_picking_dot_matrix">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <pre style="font-family: 'monospace', 'Courier New', Courier; font-size: 10pt; line-height: 1.1;">
                                DELIVERY ORDER (SURAT JALAN)
                                <t t-esc="o.company_id.name"/>
                <t t-esc="(o.company_id.street or '') + ', ' + (o.company_id.street2 or '') + ', ' + (o.company_id.city or '') + ' ' + (o.company_id.zip or '')"/>
----------------------------------------------------------------------------
DO No        : <t t-esc="o.name.ljust(22)"/>Order Type: <t t-esc="o.picking_type_id.name"/>
Shipping Date: <t t-esc="o.scheduled_date.strftime('%d/%m/%Y')"/>
----------------------------------------------------------------------------
Partner      : <t t-esc="o.partner_id.name.ljust(22)"/>Phone: <t t-esc="o.partner_id.phone or ''"/>
Delivery Address:
<t t-esc="o.partner_id.street or ''"/>
<t t-esc="(o.partner_id.street2 or '') + ' ' + (o.partner_id.city or '') + ' ' + (o.partner_id.zip or '')"/>
----------------------------------------------------------------------------
| No | Product                       |   Ordered | Delivered |
|----|-------------------------------|-----------|-----------|
<t t-if="o.state != 'done'">
    <t t-set="i" t-value="1"/>
    <t t-foreach="o.move_ids.filtered(lambda x: x.product_uom_qty)" t-as="move">
| <t t-esc="str(i).ljust(2)"/> | <t t-esc="move.product_id.name[:29].ljust(29)"/> | <t t-esc="'%.2f' % move.product_uom_qty).rjust(9)"/> | <t t-esc="'%.2f' % move.quantity).rjust(9)"/> |
        <t t-set="i" t-value="i+1"/>
    </t>
</t>
<t t-if="o.state == 'done'">
    <t t-set="i" t-value="1"/>
    <t t-foreach="o.move_line_ids_without_package" t-as="line">
| <t t-esc="str(i).ljust(2)"/> | <t t-esc="line.product_id.name[:29].ljust(29)"/> | <t t-esc="'%.2f' % line.quantity).rjust(9)"/> | <t t-esc="'%.2f' % line.qty_done).rjust(9)"/> |
        <t t-set="i" t-value="i+1"/>
    </t>
</t>
----------------------------------------------------------------------------
Notes:
<t t-esc="o.note"/>
----------------------------------------------------------------------------
                </pre>
            </t>
        </t>
    </template>
</odoo>