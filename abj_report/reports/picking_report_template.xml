<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="template_custom_stock_picking">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <style>
                    body {
                        font-family: 'Helvetica', 'Arial', sans-serif;
                        font-size: 10pt;
                    }
                    .page {
                        padding: 1cm;
                        width: 100%;
                    }
                    .table th, .table td {
                        padding: 4px;
                    }
                    .table thead th {
                        border-bottom: 2px solid black;
                        text-align: left;
                        font-weight: bold;
                    }
                    .text-end {
                        text-align: right;
                    }
                    .text-center {
                        text-align: center;
                    }
                    .mt-4 {
                        margin-top: 1.5rem !important;
                    }
                    .mt-2 {
                        margin-top: 0.5rem !important;
                    }
                    .mb-4 {
                         margin-bottom: 1.5rem !important;
                    }
                    .m-0 {
                        margin: 0 !important;
                    }
                    .row {
                        display: flex;
                        flex-wrap: wrap;
                        width: 100%;
                    }
                    .col-4, .col-5, .col-7, .col-8, .col-12 {
                        position: relative;
                        width: 100%;
                        padding-right: 15px;
                        padding-left: 15px;
                    }
                    .col-4 { flex: 0 0 33.333333%; max-width: 33.333333%; }
                    .col-5 { flex: 0 0 41.666667%; max-width: 41.666667%; }
                    .col-7 { flex: 0 0 58.333333%; max-width: 58.333333%; }
                    .col-8 { flex: 0 0 66.666667%; max-width: 66.666667%; }
                    .col-12 { flex: 0 0 100%; max-width: 100%; }
                </style>
                
                <div class="page">
                    <div class="row">
                        <div class="col-8">
                            <h3><span t-field="o.company_id.name"/></h3>
                        </div>
                        <div class="col-4 text-end">
                            <h3>DELIVERY ORDER</h3>
                        </div>
                    </div>

                    <div class="row mt-4">
                        <div class="col-7">
                            <strong>Address:</strong><br/>
                            <div t-field="o.partner_id"
                                 t-options='{"widget": "contact", "fields": ["name", "address"], "no_marker": True}'/>
                        </div>
                        <div class="col-5">
                            <strong>DO No:</strong>
                            <p class="m-0" t-field="o.name"/>
                            <strong class="mt-2">Order Type:</strong>
                            <p class="m-0" t-field="o.picking_type_id.name"/>
                            <strong class="mt-2">Shipping Date:</strong>
                            <p class="m-0" t-if="o.state == 'done'" t-field="o.date_done" t-options='{"format": "dd/MM/yyyy"}'/>
                            <p class="m-0" t-else="" t-field="o.scheduled_date" t-options='{"format": "dd/MM/yyyy"}'/>
                            <strong class="mt-2">Phone:</strong>
                            <p class="m-0" t-field="o.partner_id.phone"/>
                        </div>
                    </div>

                    <table class="table table-sm mt-4">
                        <thead>
                            <tr>
                                <th name="th_product"><strong>Product Name</strong></th>
                                <th name="th_ordered" class="text-center"><strong>Ordered Product</strong></th>
                                <th name="th_delivered" class="text-center"><strong>Delivered</strong></th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-if="o.state != 'done'">
                                <tr t-foreach="o.move_ids.filtered(lambda x: x.product_uom_qty)" t-as="move">
                                    <td><span t-field="move.product_id.display_name"/></td>
                                    <td class="text-center"><span t-field="move.product_uom_qty"/> <span t-field="move.product_uom.name" groups="uom.group_uom"/></td>
                                    <td class="text-center"><span t-field="move.quantity"/> <span t-field="move.product_uom.name" groups="uom.group_uom"/></td>
                                </tr>
                            </t>
                            <t t-if="o.state == 'done'">
                                <tr t-foreach="o.move_line_ids_without_package" t-as="line">
                                    <td><span t-field="line.product_id.display_name"/></td>
                                    <td class="text-center"><span t-field="line.quantity"/> <span t-field="line.product_uom_id.name" groups="uom.group_uom"/></td>
                                    <td class="text-center"><span t-field="line.qty_done"/> <span t-field="line.product_uom_id.name" groups="uom.group_uom"/></td>
                                </tr>
                            </t>
                        </tbody>
                    </table>

                    <div class="row mt-4">
                        <div class="col-12">
                            <strong>Notes:</strong><br/>
                            <p t-field="o.note"/>
                        </div>
                    </div>
                </div>
            </t>
        </t>
    </template>
</odoo>