<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="template_custom_stock_picking">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <div class="page">
                        <div class="row">
                            <div class="col-6">
                                <strong>Alamat Tujuan:</strong><br/>
                                <div t-field="o.partner_id"
                                      t-options='{"widget": "contact", "fields": ["address", "name"], "no_marker": True}'/>
                            </div>
                            <div class="col-5 offset-1 text-end">
                                <h2 t-field="o.name"/>
                                <div t-field="o.picking_type_id" t-options='{"widget": "badge"}'/>
                            </div>
                        </div>
                        
                        <div class="row mt-4 mb-4">
                             <div t-if="o.origin" class="col-6">
                                <strong>Dokumen Sumber:</strong>
                                <p t-field="o.origin" class="m-0"/>
                            </div>
                            <div class="col-6 text-end">
                                <strong>Tanggal Pengiriman:</strong>
                                <p t-if="o.state == 'done'" t-field="o.date_done" class="m-0"/>
                                <p t-else="" t-field="o.scheduled_date" class="m-0"/>
                            </div>
                        </div>

                        <table class="table table-sm" t-if="o.state != 'done'" name="stock_move_table">
                            <thead>
                                <tr>
                                    <th>Produk</th>
                                    <th class="text-center">Jumlah Diminta</th>
                                    <th class="text-center">Jumlah Selesai</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-set="lines" t-value="o.move_ids.filtered(lambda x: x.product_uom_qty)"/>
                                <tr t-foreach="lines" t-as="move">
                                    <td>
                                        <span t-field="move.product_id.display_name"/>
                                        <p t-if="move.description_picking" class="m-0 text-muted">
                                            <small><span t-field="move.description_picking"/></small>
                                        </p>
                                    </td>
                                    <td class="text-center">
                                        <span t-field="move.product_uom_qty"/> <span t-field="move.product_uom.name"/>
                                    </td>
                                    <td class="text-center">
                                        <span t-field="move.quantity"/> <span t-field="move.product_uom.name"/>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                        
                        <table class="table table-sm" t-if="o.state == 'done'" name="stock_move_line_table">
                            <thead>
                                <tr>
                                    <th>Produk</th>
                                    <th class="text-center">Jumlah Selesai</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="o.move_line_ids_without_package" t-as="line">
                                    <td>
                                        <span t-field="line.product_id.display_name"/>
                                        <p t-if="line.move_id.description_picking" class="m-0 text-muted">
                                            <small><span t-field="line.move_id.description_picking"/></small>
                                        </p>
                                    </td>
                                    <td class="text-center">
                                        <span t-field="line.qty_done"/> <span t-field="line.product_uom_id.name"/>
                                    </td>
                                </tr>
                            </tbody>
                        </table>

                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>