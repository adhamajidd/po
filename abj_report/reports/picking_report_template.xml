<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="template_custom_stock_picking">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <div class="page">
                        <div class="row">
                            <div class="col-6">
                                <strong>Alamat Tujuan:</strong><br/>
                                <span t-field="o.partner_id" 
                                      t-options='{"widget": "contact", "fields": ["address", "name"], "no_marker": True}'/>
                            </div>
                            <div class="col-5 offset-1 text-end">
                                <h2 t-field="o.name"/>
                                <div t-field="o.picking_type_id" t-options='{"widget": "badge"}'/>
                            </div>
                        </div>

                        <table class="table table-sm mt-4">
                            <thead>
                                <tr>
                                    <th>Produk</th>
                                    <th class="text-center">Jumlah Diminta</th>
                                    <th class="text-center">Jumlah Selesai</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="o.move_line_ids_without_package" t-as="line">
                                    <td>
                                        <span t-field="line.product_id.display_name"/><br/>
                                        <small><span t-field="line.product_id.default_code"/></small>
                                    </td>
                                    <td class="text-center">
                                        <span t-field="line.quantity"/> <span t-field="line.product_uom_id.name"/>
                                    </td>
                                    <td class="text-center">
                                        <span t-field="line.qty_done"/> <span t-field="line.product_uom_id.name"/>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                        
                        <div class="row mt-4">
                            <div class="col-6">
                                <strong>Dokumen Sumber:</strong> <span t-field="o.origin"/>
                            </div>
                            <div class="col-6 text-end">
                                <strong>Tanggal Selesai:</strong> <span t-field="o.date_done"/>
                            </div>
                        </div>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>