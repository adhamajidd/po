<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="template_custom_stock_picking">
        <t t-call="web.html_container">
            <t t-call="web.basic_layout">
                <t t-foreach="docs" t-as="o">
                    <div class="page">
                        
                        <div class="row">
                            <div class="text-center">
                                DELIVERY ORDER
                                <br/>
                                <span t-field="o.company_id.name"/>
                            </div>
                        </div>

                        <table class="table table-borderless mt-4" style="width: 100%;">
                            <tbody>
                                <tr>
                                    <td style="width: 55%; vertical-align: top; padding: 0;">
                                        Partner:
                                        <span t-field="o.partner_id.name"/> <br/>
                                        Address:
                                        <span t-raw="(o.partner_id.street or '') + ' ' + (o.partner_id.street2 or '') + ' ' + (o.partner_id.city or '') + ' ' + (o.partner_id.zip or '') + ' ' + (o.partner_id.country_id.name or '')"/>

                                    </td>
                                    <td style="width: 45%; vertical-align: top; padding: 0;">
                                        <table class="table table-borderless table-sm">
                                            <tr>
                                                <td style="padding: 0; width: 40%;">DO No</td>
                                                <td style="padding: 0; width: 5%;">:</td>
                                                <td style="padding: 0; width: 55%;"><span t-field="o.name"/></td>
                                            </tr>
                                            <tr>
                                                <td style="padding: 0;">Order Type</td>
                                                <td style="padding: 0;">:</td>
                                                <td style="padding: 0;"><span t-field="o.picking_type_id.name"/></td>
                                            </tr>
                                            <tr>
                                                <td style="padding: 0;">Shipping Date</td>
                                                <td style="padding: 0;">:</td>
                                                <td style="padding: 0;">
                                                    <span t-if="o.state == 'done'" t-field="o.date_done" t-options='{"format": "dd/MM/yyyy"}'/>
                                                    <span t-else="" t-field="o.scheduled_date" t-options='{"format": "dd/MM/yyyy"}'/>
                                                </td>
                                            </tr>
                                            <tr>
                                                <td style="padding: 0;">Phone</td>
                                                <td style="padding: 0;">:</td>
                                                <td style="padding: 0;"><span t-field="o.partner_id.phone"/></td>
                                            </tr>
                                        </table>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                        
                        <table class="table table-sm mt-4">
                            <thead>
                                <tr>
                                    <th name="th_product" style="width: 60%;">Product Name</th>
                                    <th name="th_ordered" class="text-center" style="width: 20%;">Ordered Product</th>
                                    <th name="th_delivered" class="text-center" style="width: 20%;">Delivered</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-if="o.state != 'done'">
                                    <tr t-foreach="o.move_ids.filtered(lambda x: x.product_uom_qty)" t-as="move">
                                        <td style="width: 60%;"><span t-field="move.product_id.display_name"/></td>
                                        <td class="text-center" style="width: 20%;"><span t-field="move.product_uom_qty"/> <span t-field="move.product_uom.name" groups="uom.group_uom"/></td>
                                        <td class="text-center" style="width: 20%;"><span t-field="move.quantity"/> <span t-field="move.product_uom.name" groups="uom.group_uom"/></td>
                                    </tr>
                                </t>
                                <t t-if="o.state == 'done'">
                                    <tr t-foreach="o.move_line_ids_without_package" t-as="line">
                                        <td style="width: 60%;"><span t-field="line.product_id.display_name"/></td>
                                        <td class="text-center" style="width: 20%;"><span t-field="int(line.quantity)"/> <span t-field="line.product_uom_id.name" groups="uom.group_uom"/></td>
                                        <td class="text-center" style="width: 20%;"><span t-field="int(line.qty_done)"/> <span t-field="line.product_uom_id.name" groups="uom.group_uom"/></td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>

                        <div class="row mt-4">
                            <div class="col-12">
                                Notes:<br/>
                                <p t-field="o.note"/>
                            </div>
                        </div>

                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>