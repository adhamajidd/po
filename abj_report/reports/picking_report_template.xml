<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="template_custom_stock_picking">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <div class="page" style="font-family: 'Helvetica', 'Arial', sans-serif; font-size: 10pt;">
                    
                    <table style="width: 100%; vertical-align: top;">
                        <tr>
                            <td style="width: 60%;">
                                <h3><span t-field="o.company_id.name"/></h3>
                            </td>
                            <td style="width: 40%; text-align: right;">
                                <h3>DELIVERY ORDER</h3>
                            </td>
                        </tr>
                    </table>

                    <table style="width: 100%; vertical-align: top; margin-top: 20px;">
                        <tr>
                            <td style="width: 55%; padding-right: 20px;">
                                <strong>Address:</strong><br/>
                                <div t-field="o.partner_id"
                                     t-options='{"widget": "contact", "fields": ["name", "address"], "no_marker": True}'/>
                            </td>
                            <td style="width: 45%;">
                                <strong>DO No:</strong>
                                <p style="margin: 0;" t-field="o.name"/>
                                <br/>
                                <strong>Order Type:</strong>
                                <p style="margin: 0;" t-field="o.picking_type_id.name"/>
                                <br/>
                                <strong>Shipping Date:</strong>
                                <p style="margin: 0;" t-if="o.state == 'done'" t-field="o.date_done" t-options='{"format": "dd/MM/yyyy"}'/>
                                <p style="margin: 0;" t-else="" t-field="o.scheduled_date" t-options='{"format": "dd/MM/yyyy"}'/>
                                <br/>
                                <strong>Phone:</strong>
                                <p style="margin: 0;" t-field="o.partner_id.phone"/>
                            </td>
                        </tr>
                    </table>

                    <table class="table" style="width: 100%; margin-top: 20px;">
                        <thead>
                            <tr>
                                <th style="text-align: left; border-bottom: 2px solid black; padding: 4px;"><strong>Product Name</strong></th>
                                <th style="text-align: center; border-bottom: 2px solid black; padding: 4px;"><strong>Ordered Product</strong></th>
                                <th style="text-align: center; border-bottom: 2px solid black; padding: 4px;"><strong>Delivered</strong></th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-if="o.state != 'done'">
                                <tr t-foreach="o.move_ids.filtered(lambda x: x.product_uom_qty)" t-as="move">
                                    <td style="padding: 4px;"><span t-field="move.product_id.display_name"/></td>
                                    <td style="text-align: center; padding: 4px;"><span t-field="move.product_uom_qty"/> <span t-field="move.product_uom.name" groups="uom.group_uom"/></td>
                                    <td style="text-align: center; padding: 4px;"><span t-field="move.quantity"/> <span t-field="move.product_uom.name" groups="uom.group_uom"/></td>
                                </tr>
                            </t>
                            <t t-if="o.state == 'done'">
                                <tr t-foreach="o.move_line_ids_without_package" t-as="line">
                                    <td style="padding: 4px;"><span t-field="line.product_id.display_name"/></td>
                                    <td style="text-align: center; padding: 4px;"><span t-field="line.quantity"/> <span t-field="line.product_uom_id.name" groups="uom.group_uom"/></td>
                                    <td style="text-align: center; padding: 4px;"><span t-field="line.qty_done"/> <span t-field="line.product_uom_id.name" groups="uom.group_uom"/></td>
                                </tr>
                            </t>
                        </tbody>
                    </table>

                    <div style="margin-top: 20px;">
                        <strong>Notes:</strong><br/>
                        <p t-field="o.note"/>
                    </div>
                </div>
            </t>
        </t>
    </template>
</odoo>