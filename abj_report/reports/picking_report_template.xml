<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="template_custom_stock_picking">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <div class="article">
                    <style>
                        .dot-matrix-font {
                            font-family: 'monospace', 'Courier New', Courier;
                            font-size: 10pt;
                            line-height: 1.2;
                        }
                        .header-table, .content-table, .footer-table {
                            width: 100%;
                            border-collapse: collapse;
                        }
                        .header-table td, .footer-table td {
                            padding: 2px 0;
                        }
                        .content-table th, .content-table td {
                            border-bottom: 1px solid black;
                            padding: 4px 2px;
                            text-align: left;
                        }
                        .text-right {
                            text-align: right;
                        }
                        .text-center {
                            text-align: center;
                        }
                        .no-border {
                            border: none !important;
                        }
                    </style>

                    <div class="dot-matrix-font">
                        <table class="header-table">
                            <tr>
                                <td style="width: 70%;">
                                    <strong><span t-field="o.company_id.name"/></strong><br/>
                                    <span t-field="o.company_id.partner_id" 
                                          t-options='{"widget": "contact", "fields": ["address"], "no_marker": True}'/>
                                </td>
                                <td style="width: 30%;" class="text-right">
                                    <strong>DELIVERY ORDER (SURAT JALAN)</strong>
                                </td>
                            </tr>
                        </table>
                        
                        <br/>

                        <table class="header-table">
                             <tr>
                                <td style="width: 60%;">
                                    <strong>Address:</strong><br/>
                                    <div t-field="o.partner_id" 
                                         t-options='{"widget": "contact", "fields": ["name", "address", "phone"], "no_marker": True}'/>
                                </td>
                                <td style="width: 40%; vertical-align: top;">
                                    <strong>DO No:</strong> <span t-field="o.name"/><br/>
                                    <strong>Order Type:</strong> <span t-field="o.picking_type_id.name"/><br/>
                                    <strong>Shipping Date:</strong> 
                                    <span t-if="o.state == 'done'" t-field="o.date_done" t-options='{"format": "dd/MM/yyyy"}'/>
                                    <span t-else="" t-field="o.scheduled_date" t-options='{"format": "dd/MM/yyyy"}'/>
                                </td>
                            </tr>
                        </table>
                        
                        <br/>

                        <table class="content-table">
                            <thead>
                                <tr>
                                    <th style="width: 60%;">Product</th>
                                    <th class="text-center" style="width: 20%;">Ordered</th>
                                    <th class="text-center" style="width: 20%;">Delivered</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-if="o.state == 'done'">
                                    <tr t-foreach="o.move_line_ids_without_package" t-as="line">
                                        <td><span t-field="line.product_id.display_name"/></td>
                                        <td class="text-center"><span t-field="line.quantity"/> <span t-field="line.product_uom_id.name" groups="uom.group_uom"/></td>
                                        <td class="text-center"><span t-field="line.qty_done"/> <span t-field="line.product_uom_id.name" groups="uom.group_uom"/></td>
                                    </tr>
                                </t>
                                <t t-else="">
                                     <tr t-foreach="o.move_ids.filtered(lambda x: x.product_uom_qty)" t-as="move">
                                        <td><span t-field="move.product_id.display_name"/></td>
                                        <td class="text-center"><span t-field="move.product_uom_qty"/> <span t-field="move.product_uom.name" groups="uom.group_uom"/></td>
                                        <td class="text-center"><span t-field="move.quantity"/> <span t-field="move.product_uom.name" groups="uom.group_uom"/></td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>
                        
                        <br/><br/>

                        <table class="footer-table">
                            <tr>
                                <td style="width: 60%;">
                                    <strong>Notes:</strong><br/>
                                    <span t-field="o.note"/>
                                </td>
                                <td style="width: 40%;" class="text-center">
                                    Diterima oleh,<br/><br/><br/><br/>
                                    (....................)
                                </td>
                            </tr>
                        </table>
                    </div>
                </div>
            </t>
        </t>
    </template>
</odoo>