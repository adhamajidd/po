<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="template_custom_stock_picking">
        <t t-call="web.html_container">
            <t t-call="web.basic_layout">
                <t t-foreach="docs" t-as="o">
                    <div class="page">
                        
                        <div class="row">
                            <div class="text-center">
                                <h3>DELIVERY ORDER</h3>
                            </div>
                        </div>

                        <table class="table table-borderless mt-4" style="width: 100%;">
                            <tbody>
                                <tr>
                                    <td style="width: 55%; vertical-align: top; padding: 0;">
                                        <span t-field="o.company_id.name"/>
                                        <strong>Address:</strong><br/>
                                        <div t-field="o.partner_id"
                                             t-options='{"widget": "contact", "fields": ["name", "address"], "no_marker": True}'/>
                                    </td>
                                    <td style="width: 45%; vertical-align: top; padding: 0;">
                                        <table class="table table-borderless table-sm">
                                            <tr>
                                                <td style="padding: 0; width: 40%;"><strong>DO No</strong></td>
                                                <td style="padding: 0; width: 5%;">:</td>
                                                <td style="padding: 0; width: 55%;"><span t-field="o.name"/></td>
                                            </tr>
                                            <tr>
                                                <td style="padding: 0;"><strong>Order Type</strong></td>
                                                <td style="padding: 0;">:</td>
                                                <td style="padding: 0;"><span t-field="o.picking_type_id.name"/></td>
                                            </tr>
                                            <tr>
                                                <td style="padding: 0;"><strong>Shipping Date</strong></td>
                                                <td style="padding: 0;">:</td>
                                                <td style="padding: 0;">
                                                    <span t-if="o.state == 'done'" t-field="o.date_done" t-options='{"format": "dd/MM/yyyy"}'/>
                                                    <span t-else="" t-field="o.scheduled_date" t-options='{"format": "dd/MM/yyyy"}'/>
                                                </td>
                                            </tr>
                                            <tr>
                                                <td style="padding: 0;"><strong>Phone</strong></td>
                                                <td style="padding: 0;">:</td>
                                                <td style="padding: 0;"><span t-field="o.partner_id.phone"/></td>
                                            </tr>
                                        </table>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                        
                        <table class="table table-sm mt-4">
                            <thead>
                                <tr>
                                    <th name="th_product"><strong>Product Name</strong></th>
                                    <th name="th_ordered" class="text-center"><strong>Ordered Product</strong></th>
                                    <th name="th_delivered" class="text-center"><strong>Delivered</strong></th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-if="o.state != 'done'">
                                    <tr t-foreach="o.move_ids.filtered(lambda x: x.product_uom_qty)" t-as="move">
                                        <td><span t-field="move.product_id.display_name"/></td>
                                        <td class="text-center"><span t-field="move.product_uom_qty"/> <span t-field="move.product_uom.name" groups="uom.group_uom"/></td>
                                        <td class="text-center"><span t-field="move.quantity"/> <span t-field="move.product_uom.name" groups="uom.group_uom"/></td>
                                    </tr>
                                </t>
                                <t t-if="o.state == 'done'">
                                    <tr t-foreach="o.move_line_ids_without_package" t-as="line">
                                        <td><span t-field="line.product_id.display_name"/></td>
                                        <td class="text-center"><span t-field="line.quantity"/> <span t-field="line.product_uom_id.name" groups="uom.group_uom"/></td>
                                        <td class="text-center"><span t-field="line.qty_done"/> <span t-field="line.product_uom_id.name" groups="uom.group_uom"/></td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>

                        <div class="row mt-4">
                            <div class="col-12">
                                <strong>Notes:</strong><br/>
                                <p t-field="o.note"/>
                            </div>
                        </div>

                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>