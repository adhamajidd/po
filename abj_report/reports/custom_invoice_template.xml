<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="template_invoice_dot_matrix">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <pre style="font-family: 'monospace', 'Courier New', Courier; font-size: 10pt; line-height: 1.1;">
<t t-esc="o.company_id.name.ljust(45)"/>PROFORMA INVOICE
<t t-esc="(o.company_id.street or '') + ', ' + (o.company_id.street2 or '')"/>
<t t-esc="(o.company_id.city or '') + ' ' + (o.company_id.zip or '') + ' ' + (o.company_id.country_id.name or '')"/>
--------------------------------------------------------------------------------
Customer : <t t-esc="o.partner_id.name.ljust(43)"/>Invoice No : <t t-esc="o.name"/>
Alamat   : <t t-esc="(o.partner_id.street or '').ljust(43)"/>Tanggal    : <t t-esc="o.invoice_date.strftime('%d/%m/%Y')"/>
<t t-esc="((o.partner_id.street2 or '') + ' ' + (o.partner_id.city or '')).ljust(54)"/>Jatuh Tempo: <t t-esc="o.invoice_date_due.strftime('%d/%m/%Y')"/>
--------------------------------------------------------------------------------
Description                             Qty     Harga         Total
--------------------------------------------------------------------------------
<t t-foreach="o.invoice_line_ids" t-as="line">
<t t-esc="line.name.replace('\n', ' ').ljust(39)[:39]"/><t t-esc="str(int(line.quantity)).rjust(4)"/> <t t-esc="'{:,}'.format(line.price_unit).rjust(10)"/> <t t-esc="'{:,}'.format(line.price_subtotal).rjust(12)"/>
</t>
--------------------------------------------------------------------------------
                                              Subtotal : <t t-esc="'{:,}'.format(o.amount_untaxed).rjust(12)"/>
                                                   Tax : <t t-esc="'{:,}'.format(o.amount_tax).rjust(12)"/>
                                                 TOTAL : <t t-esc="'{:,}'.format(o.amount_total).rjust(12)"/>
--------------------------------------------------------------------------------
Ref Pembayaran: <t t-esc="o.payment_reference or o.name"/>
                </pre>
            </t>
        </t>
    </template>
</odoo>