<odoo>
    <!-- Definisi Paper Format A5 dengan margin atas 10 mm -->
    <record id="paperformat_a5_margin10" model="report.paperformat">
        <field name="name">A5 Margin Top 10mm</field>
        <field name="default" eval="False"/>
        <field name="format">A5</field>
        <field name="page_width">148</field> <!-- A5 width dalam mm -->
        <field name="page_height">210</field> <!-- A5 height dalam mm -->
        <field name="orientation">Portrait</field>
        <field name="margin_top">10</field>
        <field name="margin_bottom">15</field>
        <field name="margin_left">10</field>
        <field name="margin_right">10</field>
        <field name="dpi">90</field>
    </record>
</odoo>
